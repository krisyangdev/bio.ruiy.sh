---
import Portfolio from "../components/Portfolio";
import "../styles/portfolio.css";

const title = "Kris Yang — AI Product Developer";
const description =
  "Independent developer in Shanghai building local-first AI products and open-source systems.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://krisyang.dev/#kris",
      name: "Kris Yang",
      url: "https://krisyang.dev",
      image: "https://krisyang.dev/avatar.webp",
      jobTitle: "Independent AI Product Developer",
      homeLocation: { "@type": "Place", name: "Shanghai, China" },
      sameAs: ["https://github.com/krisyangdev", "https://x.com/krisyangdev"],
    },
    {
      "@type": "WebSite",
      "@id": "https://krisyang.dev/#website",
      url: "https://krisyang.dev",
      name: title,
      description,
      author: { "@id": "https://krisyang.dev/#kris" },
    },
  ],
};
---

<!doctype html>
<html lang="en" data-locale="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f3f1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://krisyang.dev/og.png?v=20261031"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Kris Yang's personal site" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@krisyangdev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content="https://krisyang.dev/og.png?v=20261031"
    />
    <title>{title}</title>
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <Portfolio client:load />
  </body>
</html>
